@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SchoolManagement.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admissions/apply">Apply for admission</NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <AuthorizeView Roles="@SchoolRoles.SuperAdmin">
                    <Authorized Context="roleContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/school-profile">School profile</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/academic-years">Academic years</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/classes">Classes and sections</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/users">User management</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/teacher-assignments">Teachers and subjects</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/examinations">Examinations and grading</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/results/revisions">Result revisions</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/audit">Audit and background jobs</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@(SchoolRoles.SuperAdmin + "," + SchoolRoles.AdmissionOfficer)">
                    <Authorized Context="admissionsContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/admissions">Admission applications</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="students">Students</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/import-export">Imports and exports</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@SchoolRoles.Teacher">
                    <Authorized Context="teacherContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="teacher">Teacher dashboard</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="attendance/reports">Attendance reports</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="attendance/corrections">Correction requests</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="examinations/marks">Examination marks</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="messages">Parent messages</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@(SchoolRoles.Principal + "," + SchoolRoles.SuperAdmin)">
                    <Authorized Context="attendanceManagementContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="attendance/reports">Attendance reports</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="attendance/corrections">Attendance corrections</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="examinations/review">Result review</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="finance/discounts">Discount approvals</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="finance/refunds">Refund approvals</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@(SchoolRoles.Accountant + "," + SchoolRoles.SuperAdmin)">
                    <Authorized Context="financeContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="finance">Fees and finance</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@SchoolRoles.Accountant">
                    <Authorized Context="accountantContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/import-export">Imports and exports</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@SchoolRoles.ParentStudent">
                    <Authorized Context="parentContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="parent/attendance">Children's attendance</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="parent/results">Published report cards</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="parent/fees">Children's fees</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="messages">Message teachers</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="announcements">School announcements</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
