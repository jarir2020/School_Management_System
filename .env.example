# Copy to .env, restrict file permissions, and replace each sample value.
APP_PORT=8080
MYSQL_PORT=3307
MYSQL_DATABASE=school_management
MYSQL_USER=school_app
MYSQL_PASSWORD=CHANGE_ME_USE_A_RANDOM_HEX_VALUE
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_ANOTHER_RANDOM_HEX_VALUE
ALLOWED_HOSTS=school.example.com
TRUSTED_PROXY_IP=172.29.0.1
DATAPROTECTION_CERT_FILE=/etc/school-management/data-protection.pfx
DATAPROTECTION_CERT_PASSWORD_FILE=/etc/school-management/data-protection-password
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=School Administrator
